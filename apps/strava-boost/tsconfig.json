{
	"extends": "@plan-my-route/typescript-config/nextjs.json",
	"compilerOptions": {
		"types": ["node", "react", "react-dom"],
		"paths": {
			"@/*": ["./*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"**/*.mts"
	],
	"exclude": ["node_modules", "**/*.test.ts", "**/*.test.tsx"]
}
